#!/usr/bin/env bash
set -Eeuo pipefail
umask 0027

readonly APP_ROOT='/var/www/staging-easytire.bethub.fun'
readonly RELEASES="$APP_ROOT/releases"
readonly SHARED="$APP_ROOT/shared"
readonly CURRENT="$APP_ROOT/current"
readonly DEPLOY_LOCK="$APP_ROOT/deploy.lock"
readonly BRANCH='refs/heads/main'
readonly COMPOSER='/usr/local/bin/composer'

log() { printf '[staging-easytire] %s\n' "$*"; }
fail() { log "Deployment failed: $*" >&2; exit 1; }

while read -r oldrev newrev refname; do
    [[ "$refname" == "$BRANCH" ]] || continue
    [[ "$newrev" != '0000000000000000000000000000000000000000' ]] || fail 'Refusing branch deletion.'

    exec 9>"$DEPLOY_LOCK"
    flock -n 9 || fail 'Another deployment is already running.'

    [[ -d "$RELEASES" && -d "$SHARED" && -f "$SHARED/.env" ]] || fail 'Shared deployment state is incomplete.'
    release_id="$(date -u +%Y%m%d%H%M%S)-${newrev:0:12}"
    release="$RELEASES/$release_id"
    [[ "$release" == "$RELEASES/"* && ! -e "$release" ]] || fail 'Invalid release target.'

    mkdir -p "$release"
    trap 'rm -rf -- "$release"' ERR
    GIT_WORK_TREE="$release" git checkout --force "$newrev" -- .
    printf '%s\n' "$newrev" > "$release/REVISION"
    app="$release/application"
    [[ "$app" == "$release/application" && -f "$app/artisan" && -f "$app/composer.json" ]] || fail 'Laravel application is missing from release/application.'
    cp -- "$SHARED/.env" "$app/.env"
    app_storage="$app/storage"
    [[ "$app_storage" == "$release/application/storage" && -d "$app_storage" ]] || fail 'Unsafe application storage target.'
    rm -rf -- "$app_storage"
    ln -s -- "$SHARED/storage" "$app_storage"
    [[ ! -e "$app/public/storage" ]] || fail 'Refusing to replace existing public storage path.'
    ln -s -- "$SHARED/storage/app/public" "$app/public/storage"
    mkdir -p "$app/bootstrap/cache"
    chgrp -R www-data "$app/bootstrap/cache"
    chmod -R g+rwX "$app/bootstrap/cache"
    chgrp www-data "$app/.env"
    chmod 640 "$app/.env"

    (
        cd "$app"
        "$COMPOSER" install --prefer-dist --no-interaction --optimize-autoloader
        npm ci --no-audit --no-fund
        npm run build
        php artisan test
        php artisan easytire:backup:mysql --no-interaction
        php artisan migrate --force --no-interaction
        php artisan config:cache
        php artisan route:cache
        php artisan view:cache
    )

    new_current="$APP_ROOT/.current-$release_id"
    ln -s -- "$release" "$new_current"
    mv -Tf -- "$new_current" "$CURRENT"
    trap - ERR
    log "Activated release $release_id."

    (
        cd "$app"
        php artisan queue:restart --no-interaction
    ) || log 'Queue restart signal failed; the max-time limit will still recycle the worker.'

    (
        cd "$app"
        php artisan easytire:backup:prune --no-interaction
    ) || log 'Backup retention cleanup failed; completed backups were left intact.'

    mapfile -t old_releases < <(find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -nr | awk 'NR > 5 {print $2}')
    for old_release in "${old_releases[@]}"; do
        [[ "$old_release" == "$RELEASES/"* && -d "$old_release" && "$old_release" != "$release" ]] || fail 'Unsafe release prune target.'
        rm -rf -- "$old_release"
    done
done
