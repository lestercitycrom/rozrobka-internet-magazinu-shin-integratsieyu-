#!/usr/bin/env bash
set -Eeuo pipefail
umask 0027

readonly APP_ROOT='/var/www/staging-easytire.bethub.fun'
readonly RELEASES="$APP_ROOT/releases"
readonly SHARED="$APP_ROOT/shared"
readonly CURRENT="$APP_ROOT/current"
readonly DEPLOY_LOCK="$APP_ROOT/deploy.lock"
readonly BRANCH='refs/heads/main'
readonly COMPOSER='/usr/local/bin/composer'

log() { printf '[staging-easytire] %s\n' "$*"; }
fail() { log "Deployment failed: $*" >&2; exit 1; }

while read -r oldrev newrev refname; do
    [[ "$refname" == "$BRANCH" ]] || continue
    [[ "$newrev" != '0000000000000000000000000000000000000000' ]] || fail 'Refusing branch deletion.'

    exec 9>"$DEPLOY_LOCK"
    flock -n 9 || fail 'Another deployment is already running.'

    [[ -d "$RELEASES" && -d "$SHARED" && -f "$SHARED/.env" ]] || fail 'Shared deployment state is incomplete.'
    release_id="$(date -u +%Y%m%d%H%M%S)-${newrev:0:12}"
    release="$RELEASES/$release_id"
    [[ "$release" == "$RELEASES/"* && ! -e "$release" ]] || fail 'Invalid release target.'

    mkdir -p "$release"
    database_marker="$release/.database-mutation-started"
    on_release_error() {
        if [[ ! -e "$database_marker" ]]; then
            rm -rf -- "$release"
            log 'Failed pre-database release was removed.'
        else
            log 'Failed release was retained for scoped content recovery.'
        fi
    }
    trap on_release_error ERR
    GIT_WORK_TREE="$release" git checkout --force "$newrev" -- .
    printf '%s\n' "$newrev" > "$release/REVISION"
    app="$release/application"
    [[ "$app" == "$release/application" && -f "$app/artisan" && -f "$app/composer.json" ]] || fail 'Laravel application is missing from release/application.'
    app_storage="$app/storage"
    public_storage="$app/public/storage"
    [[ "$app_storage" == "$release/application/storage" && -d "$app_storage" && ! -L "$app_storage" ]] || fail 'Candidate-local storage is missing or unsafe.'
    [[ "$public_storage" == "$release/application/public/storage" && ! -e "$public_storage" && ! -L "$public_storage" ]] || fail 'Candidate public storage path is not isolated.'
    mkdir -p "$app/bootstrap/cache"
    chgrp -R www-data "$app/bootstrap/cache"
    chmod -R g+rwX "$app/bootstrap/cache"

    # Composer and the full test suite must never inherit the persistent staging
    # database, cache, integrations or media filesystem. Build with an ephemeral
    # candidate-only environment and the physical storage checked out above.
    cp -- "$app/.env.example" "$app/.env"
    test_app_key="$(php -r 'echo "base64:".base64_encode(random_bytes(32));')"
    sed -i \
        -e 's/^APP_ENV=.*/APP_ENV=testing/' \
        -e "s|^APP_KEY=.*|APP_KEY=$test_app_key|" \
        -e 's/^APP_DEBUG=.*/APP_DEBUG=false/' \
        -e 's|^APP_URL=.*|APP_URL=http://127.0.0.1|' \
        -e 's/^DB_CONNECTION=.*/DB_CONNECTION=sqlite/' \
        -e 's/^SESSION_DRIVER=.*/SESSION_DRIVER=array/' \
        -e 's/^QUEUE_CONNECTION=.*/QUEUE_CONNECTION=sync/' \
        -e 's/^CACHE_STORE=.*/CACHE_STORE=array/' \
        -e 's/^MAIL_MAILER=.*/MAIL_MAILER=array/' \
        "$app/.env"
    printf '\nDB_DATABASE=:memory:\nDB_URL=\n' >> "$app/.env"
    chmod 600 "$app/.env"

    (
        cd "$app"
        "$COMPOSER" install --prefer-dist --no-interaction --optimize-autoloader
        npm ci --no-audit --no-fund
        npm run build
        php artisan test

        # Discard every test-created file before the persistent filesystem and
        # runtime environment become reachable by any Laravel command.
        [[ -d "$app_storage" && ! -L "$app_storage" ]] || fail 'Candidate-local storage changed during tests.'
        [[ ! -e "$public_storage" && ! -L "$public_storage" ]] || fail 'Tests created an unsafe public storage path.'
        rm -rf -- "$app_storage"
        ln -s -- "$SHARED/storage" "$app_storage"
        ln -s -- "$SHARED/storage/app/public" "$public_storage"

        cp -- "$SHARED/.env" "$app/.env"
        chgrp www-data "$app/.env"
        chmod 640 "$app/.env"
        php artisan config:clear --no-interaction
        php artisan easytire:backup:mysql --no-interaction
        : > "$database_marker"
        php artisan migrate --force --no-interaction
        php artisan db:seed --class='Database\Seeders\CustomerHomepageReleaseSeeder' --force --no-interaction
        php artisan config:cache
        php artisan route:cache
        php artisan view:cache
    )

    new_current="$APP_ROOT/.current-$release_id"
    ln -s -- "$release" "$new_current"
    mv -Tf -- "$new_current" "$CURRENT"
    trap - ERR
    log "Activated release $release_id."

    (
        cd "$app"
        php artisan queue:restart --no-interaction
    ) || log 'Queue restart signal failed; the max-time limit will still recycle the worker.'

    (
        cd "$app"
        # The cumulative release starts with 14 retained snapshots. Keep room
        # for the protected pre-migration backup and bounded recovery retries;
        # cleanup is a separate, reviewed operation after acceptance.
        php artisan easytire:backup:prune --keep=20 --no-interaction
    ) || log 'Backup retention cleanup failed; completed backups were left intact.'

    mapfile -t old_releases < <(find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -nr | awk 'NR > 5 {print $2}')
    for old_release in "${old_releases[@]}"; do
        [[ "$old_release" == "$RELEASES/"* && -d "$old_release" && "$old_release" != "$release" ]] || fail 'Unsafe release prune target.'
        rm -rf -- "$old_release"
    done
done
