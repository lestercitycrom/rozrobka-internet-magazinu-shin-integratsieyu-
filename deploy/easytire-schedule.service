[Unit]
Description=EasyTire Laravel scheduler tick
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=oneshot
User=easytire-deploy
Group=www-data
WorkingDirectory=/var/www/staging-easytire.bethub.fun/current/application
ExecStart=/usr/bin/php artisan schedule:run --no-interaction
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
