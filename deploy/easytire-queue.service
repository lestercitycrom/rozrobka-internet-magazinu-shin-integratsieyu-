[Unit]
Description=EasyTire Laravel queue worker
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=easytire-deploy
Group=www-data
WorkingDirectory=/var/www/staging-easytire.bethub.fun/current/application
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --backoff=10 --timeout=90 --max-time=3600
Restart=always
RestartSec=5
TimeoutStopSec=95
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
