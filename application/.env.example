APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=nb
APP_FALLBACK_LOCALE=nb
APP_FAKER_LOCALE=nb_NO
STOREFRONT_RU_PREVIEW_ENABLED=false
STOREFRONT_MAP_EMBED_URL="https://www.google.com/maps?q=EasyTire%20Dekkskift%20Troms%C3%B8%2C%20Ringvegen%20202%2C%209018%20Troms%C3%B8&output=embed"
STOREFRONT_STOCK_MAX_AGE_MINUTES=180
STOREFRONT_PRICE_MAX_AGE_MINUTES=1560
SERVICE_BOOKING_TIMEZONE=Europe/Oslo

NDI_PARSER_VERSION=1.1.0
NDI_RAW_DISK=local
NDI_RAW_PREFIX=ndi/raw
NDI_CATALOG_CURRENCY=
NDI_MEDIA_HOSTS=files.ndias.com
NDI_MEDIA_MAX_BYTES=5242880
NDI_MEDIA_MAX_PIXELS=20000000
NDI_MEDIA_MAX_ATTEMPTS=5
NDI_MEDIA_RETRY_AFTER_MINUTES=60
NDI_STOCK_NATIONAL_CAP=40
NDI_INBOX_PATH=
NDI_INBOX_STABLE_SECONDS=120
NDI_INBOX_RETRY_BACKOFF_MINUTES=10
NDI_IMPORT_LOCK_SECONDS=1800
NDI_STOCK_DROP_GUARD_MIN_BASELINE=50
NDI_STOCK_MINIMUM_PREVIOUS_RATIO=0.9

# NDI test PartyID confirmed as 1220000; credentials remain environment-only.
# Keep all network operations disabled in ordinary local/CI environments.
NDI_INQUIRY_ENABLED=false
NDI_ORDER_ENABLED=false
NDI_C1_TEST_MODE=false
NDI_FULFILMENT_READ_ENABLED=false
NDI_API_ENDPOINT=https://salesapi.ndias.com/EndPoint
NDI_API_USERNAME=
NDI_API_PASSWORD=
NDI_API_PARTY_ID=
NDI_API_AGENCY_CODE=
NDI_API_CONNECT_TIMEOUT=3
NDI_API_TIMEOUT=8
NDI_INQUIRY_TTL_SECONDS=300
NDI_SANDBOX_CATALOG_ENABLED=false
NDI_SANDBOX_INQUIRY_ENABLED=false
NDI_SANDBOX_ORDER_ENABLED=false
NDI_SANDBOX_PARTY_ID=1220000
NDI_SANDBOX_ARTICLE_ID=4765205551649102
NDI_SANDBOX_ORDER_QUANTITY=2
NDI_SANDBOX_STOCK_QUANTITY=2
NDI_SANDBOX_PRICE_MINOR=1000

# Dintero Checkout. Test and production use the same code path; only environment
# credentials change. Never commit real values. Manual capture is forced per session.
PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=dintero
DINTERO_ENVIRONMENT=test
DINTERO_TEST_ACCOUNT_ID=
DINTERO_PRODUCTION_ACCOUNT_ID=
DINTERO_CLIENT_ID=
DINTERO_CLIENT_SECRET=
DINTERO_PROFILE_ID=default
DINTERO_CALLBACK_SECRET=
DINTERO_REQUIRE_CALLBACK_SIGNATURE=true
DINTERO_API_BASE_URL=https://api.dintero.com/v1
DINTERO_CONNECT_TIMEOUT=3
DINTERO_TIMEOUT=10
DINTERO_VAT_PERCENT=25

OUTBOX_NOTION_ENABLED=false
OUTBOX_TELEGRAM_ENABLED=false
OUTBOX_TIMEOUT_SECONDS=5
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LOCK_TIMEOUT_SECONDS=300
# Keep both destinations disabled until the customer has provided the values below.
# Tokens belong only in the deployment environment; never commit them.
OUTBOX_NOTION_TOKEN=
OUTBOX_NOTION_DATABASE_ID=
OUTBOX_NOTION_TITLE_PROPERTY=Name
OUTBOX_NOTION_API_VERSION=2022-06-28
OUTBOX_TELEGRAM_BOT_TOKEN=
OUTBOX_TELEGRAM_CHAT_ID=
VEHICLE_FITMENT_ENABLED=false
VEHICLE_FITMENT_ENDPOINT=https://akfell-datautlevering.atlas.vegvesen.no/enkeltoppslag/kjoretoydata
VEHICLE_FITMENT_API_KEY=
VEHICLE_FITMENT_AUTH_HEADER=SVV-Authorization
VEHICLE_FITMENT_TIMEOUT=5
VEHICLE_FITMENT_CACHE_TTL=300

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
BACKUP_MYSQLDUMP_BINARY=mysqldump
BACKUP_RETENTION=14
EASYTIRE_HEALTH_DISK_FREE_WARNING_BYTES=5368709120
EASYTIRE_HEALTH_NDI_SUCCESS_MAX_AGE_MINUTES=1440
EASYTIRE_HEALTH_HEARTBEAT_MAX_AGE_MINUTES=5
EASYTIRE_HEALTH_REQUIRE_HEARTBEATS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Enable only after production SMTP and sender-domain verification.
CUSTOMER_EMAIL_DELIVERY_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
