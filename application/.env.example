APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=nb
APP_FALLBACK_LOCALE=nb
APP_FAKER_LOCALE=nb_NO
STOREFRONT_RU_PREVIEW_ENABLED=false
STOREFRONT_MAP_EMBED_URL="https://www.google.com/maps/embed?origin=mfe&pb=!1m2!2m1!1sEasyTire+Dekkskift+Troms%C3%B8,+Ringvegen+202,+9018+Troms%C3%B8"

NDI_PARSER_VERSION=1.1.0
NDI_RAW_DISK=local
NDI_RAW_PREFIX=ndi/raw
NDI_CATALOG_CURRENCY=
NDI_MEDIA_HOSTS=files.ndias.com
NDI_MEDIA_MAX_BYTES=5242880
NDI_MEDIA_MAX_PIXELS=20000000
NDI_MEDIA_MAX_ATTEMPTS=5
NDI_MEDIA_RETRY_AFTER_MINUTES=60
NDI_STOCK_NATIONAL_CAP=40

# NDI test PartyID confirmed as 1220000; credentials remain environment-only.
# Keep all network operations disabled in ordinary local/CI environments.
NDI_INQUIRY_ENABLED=false
NDI_ORDER_ENABLED=false
NDI_C1_TEST_MODE=false
NDI_FULFILMENT_READ_ENABLED=false
NDI_API_ENDPOINT=https://salesapi.ndias.com/EndPoint
NDI_API_USERNAME=
NDI_API_PASSWORD=
NDI_API_PARTY_ID=
NDI_API_AGENCY_CODE=
NDI_API_CONNECT_TIMEOUT=3
NDI_API_TIMEOUT=8
NDI_INQUIRY_TTL_SECONDS=300

# Payment remains disabled until the provider and authorization/capture policy are approved.
PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=

OUTBOX_NOTION_ENABLED=false
OUTBOX_TELEGRAM_ENABLED=false
OUTBOX_TIMEOUT_SECONDS=5
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LOCK_TIMEOUT_SECONDS=300
# Keep both destinations disabled until the customer has provided the values below.
# Tokens belong only in the deployment environment; never commit them.
OUTBOX_NOTION_TOKEN=
OUTBOX_NOTION_DATABASE_ID=
OUTBOX_NOTION_TITLE_PROPERTY=Name
OUTBOX_NOTION_API_VERSION=2022-06-28
OUTBOX_TELEGRAM_BOT_TOKEN=
OUTBOX_TELEGRAM_CHAT_ID=
VEHICLE_FITMENT_ENABLED=false
VEHICLE_FITMENT_ENDPOINT=https://www.vegvesen.no/ws/no/vegvesen/kjoretoy/felles/datautlevering/enkeltoppslag/kjoretoydata
VEHICLE_FITMENT_API_KEY=
VEHICLE_FITMENT_AUTH_HEADER=SVV-Authorization
VEHICLE_FITMENT_TIMEOUT=5
VEHICLE_FITMENT_CACHE_TTL=300

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
BACKUP_MYSQLDUMP_BINARY=mysqldump
BACKUP_RETENTION=14
EASYTIRE_HEALTH_DISK_FREE_WARNING_BYTES=5368709120
EASYTIRE_HEALTH_NDI_SUCCESS_MAX_AGE_MINUTES=1440
EASYTIRE_HEALTH_HEARTBEAT_MAX_AGE_MINUTES=5
EASYTIRE_HEALTH_REQUIRE_HEARTBEATS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
